<div class="container mt-4">
  <h1 class="border-bottom pb-2 mb-3">
    <%= @article.title %>
    <%= link_to edit_article_path(@article), class: "ml-2" do %>
      <i class="fas fa-pencil-alt"></i>
    <% end %>
    <%= link_to article_path(@article), class: "ml-1",
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } do %>
      <i class="fas fa-trash"></i>
    <% end %>
  </h1>

  <p class="lead"><%= @article.content %></p>

  <%= link_to "Back to articles", articles_path, class: "btn btn-outline-secondary btn-sm mt-3" %>
</div>